---
/** The title of the documentation in the header: the mark, the name, and the word "Documentation". */
import BrandIcon from '../landing/BrandIcon.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="docs-brand">
  <BrandIcon size={28} />
  <span class="name" translate="no">Astrolabe</span>
  <span class="sep" aria-hidden="true"></span>
  <span class="sub">Documentation</span>
</a>

<style>
  .docs-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 21px;
    color: var(--heading);
  }

  .sep {
    width: 1px;
    height: 20px;
    background: var(--line-strong);
  }

  .sub {
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .sep,
    .sub {
      display: none;
    }
  }
</style>
