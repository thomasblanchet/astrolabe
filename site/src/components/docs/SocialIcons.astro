---
/** The right side of the header: the versions, the way back to the landing page, and GitHub. */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { ASTROLABE, POLARS } from '../../lib/versions';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<span class="docs-pill">v{ASTROLABE} pre-release · Polars {POLARS}</span>
<a class="docs-home" href={base}>Home</a>
<Default />

<style>
  .docs-pill {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    white-space: nowrap;
  }

  .docs-home {
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
  }

  .docs-home:hover {
    color: var(--heading);
  }

  @media (max-width: 64rem) {
    .docs-pill {
      display: none;
    }
  }
</style>
