---
/** The document around the landing page: the head, the fonts and the base styles. */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Astrolabe · Catch Polars bugs before your code runs',
  description = 'Astrolabe tells mypy, the Python type checker, how to track the contents of your Polars dataframes. A missing column or a wrong data type becomes a type error in your editor, not a runtime failure.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site ? new URL(base, Astro.site).href : base;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1020" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
